#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf 'usage: %s OUTPUT_DIRECTORY\n' "$0" >&2
    exit 2
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(dirname -- "$script_dir")
mkdir -p "$1"
output_dir=$(CDPATH='' cd -- "$1" && pwd)
app="$output_dir/TT Notifier.app"
if [ -e "$app" ]; then
    printf 'output app already exists\n' >&2
    exit 1
fi
stage=$(mktemp -d "${TMPDIR:-/tmp}/tt-notifier-build.XXXXXX")
trap 'rm -r "$stage"' EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$stage/TT Notifier.app/Contents/MacOS" "$stage/TT Notifier.app/Contents/Resources" "$stage/TT.iconset"
for arch in arm64 x86_64; do
    /usr/bin/swiftc -O -parse-as-library -target "$arch-apple-macosx13.0" \
        -framework AppKit -framework AVFoundation -framework UserNotifications \
        -o "$stage/notifier-$arch" "$repo_dir/integrations/macos/TTNotifier.swift"
done
/usr/bin/lipo -create "$stage/notifier-arm64" "$stage/notifier-x86_64" \
    -output "$stage/TT Notifier.app/Contents/MacOS/TTNotifier"
for size in 16 32 128 256 512; do
    /usr/bin/sips -z "$size" "$size" "$repo_dir/assets/tt-icon-1024.png" \
        --out "$stage/TT.iconset/icon_${size}x${size}.png" >/dev/null
    double=$((size * 2))
    /usr/bin/sips -z "$double" "$double" "$repo_dir/assets/tt-icon-1024.png" \
        --out "$stage/TT.iconset/icon_${size}x${size}@2x.png" >/dev/null
done
/usr/bin/iconutil -c icns "$stage/TT.iconset" -o "$stage/TT Notifier.app/Contents/Resources/tt.icns"
plist="$stage/TT Notifier.app/Contents/Info.plist"
/usr/bin/plutil -create xml1 "$plist"
/usr/bin/plutil -insert CFBundleDevelopmentRegion -string en "$plist"
/usr/bin/plutil -insert CFBundleDisplayName -string tt "$plist"
/usr/bin/plutil -insert CFBundleExecutable -string TTNotifier "$plist"
/usr/bin/plutil -insert CFBundleIconFile -string tt.icns "$plist"
/usr/bin/plutil -insert CFBundleIdentifier -string com.movsar.tt.focus-notifier "$plist"
/usr/bin/plutil -insert CFBundleInfoDictionaryVersion -string 6.0 "$plist"
/usr/bin/plutil -insert CFBundleName -string tt "$plist"
/usr/bin/plutil -insert CFBundlePackageType -string APPL "$plist"
/usr/bin/plutil -insert CFBundleShortVersionString -string 3.0 "$plist"
/usr/bin/plutil -insert CFBundleVersion -string 3 "$plist"
/usr/bin/plutil -insert LSMinimumSystemVersion -string 13.0 "$plist"
/usr/bin/plutil -insert LSUIElement -bool true "$plist"
/usr/bin/codesign --force --deep --sign - "$stage/TT Notifier.app"
/usr/bin/codesign --verify --deep --strict "$stage/TT Notifier.app"
mv "$stage/TT Notifier.app" "$app"
